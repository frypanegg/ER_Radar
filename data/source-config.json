        "occurred",
        "cancelled",
        "corrected",
        "disputed"
      ],
      "frameworkEventStateCodes": {
        "planned": "PLANNED",
        "occurred": "OCCURRED",
        "cancelled": "CANCELLED",
        "corrected": "CORRECTED",
        "disputed": "DISPUTED"
      },
      "defaultStageMap": {
        "preparation": "S1",
        "bargaining": "S3",
        "breakdown_mediation": "S4",
        "industrial_action": "U",
        "tentative_agreement": "S5",
        "final_agreement": "S7",
        "manual_review": "U"
      },
      "explicitStateSignals": [
        {
          "code": "S8",
          "patterns": [
            "(?:합의사항|협약|임금\\s*인상분).{0,10}(?:이행|시행|적용|반영)",
            "(?:소급분|인상분).{0,8}(?:지급|반영)"
          ]
        },
        {
          "code": "S7",
          "patterns": [
            "(?:단체협약|임금협약|임단협).{0,10}(?:서명|조인|체결|발효|효력\\s*발생)"
          ]
        },
        {
          "code": "S6",
          "patterns": [
            "잠정\\s*합의안?.{0,14}(?:찬반투표|가결|통과|인준)",
            "(?:조합원\\s*)?찬반투표.{0,12}(?:잠정\\s*합의안?|임단협)"
          ]
        },
        {
          "code": "S2",
          "patterns": [
            "교섭창구\\s*단일화|교섭대표노조|대표교섭노조",
            "교섭단위.{0,8}(?:분리|통합|결정)",
            "(?:복수노조|대표노조).{0,10}(?:선정|확정|결정)"
          ]
        }
      ],
      "eventStatePatterns": {
