{
  "schemaVersion": 1,
  "metadataSchemas": {
    "companySelection": {
      "fields": [
        "scale",
        "industryImpact",
        "mediaExposure",
        "majorityUnion"
      ],
      "ratingValues": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNVERIFIED"
      ],
      "majorityUnionValues": [
        "O",
        "X",
        "UNKNOWN"
      ],
      "majorityUnionDefinition": "노조법 제29조의2 제4항상 교섭창구 단일화 참여노조 전체 조합원 수를 분모로 한 과반 여부",
      "separateFields": [
        "representativeBargainingUnion",
        "directEmploymentUnionizationRate"
      ],
      "verificationRule": "분자·분모·산정기준·근거일·근거URL 중 하나라도 없으면 status=UNKNOWN이며 대표교섭노조 여부나 전체 직접고용 대비 가입률과 혼용 금지"
    },
    "unionProfile": {
      "fields": [
        "memberCount",
        "electionIssues",
        "verifiedAt"
      ],
      "defaults": {
        "memberCount": null,
        "electionIssues": [],
        "verifiedAt": null,
        "needsReview": true
      }
    },
    "agreementType": {
      "values": [
        "WAGE",
        "CBA",
        "INTEGRATED"
      ],
      "scope": "current_bargaining_year"
    }
  },
  "collectionPolicy": {
    "frequency": "daily",
    "timezone": "Asia/Seoul",
    "recommendedRunTime": "06:30",
    "cron": "30 6 * * *",
    "targetWindow": "calendar_year",
    "maxItemsPerQuery": 30,
    "requestDelayMs": 300,
    "requestTimeoutMs": 15000,
    "maxRetries": 3,
    "freshnessHalfLifeDays": 30,
    "freshnessReviewDays": 120,
    "maxUrlResolutions": 150
  },
  "scopePolicy": {
    "primaryScope": "selected_legal_entity_directly_employed_union_only",
    "classifications": [
      "PRIMARY_DIRECT_UNION",
      "SUBCONTRACTOR_UNION_EXCLUDED",
      "AFFILIATE_UNION_EXCLUDED",
      "UNKNOWN_REVIEW",
      "MIXED_NEEDS_SPLIT"
    ],
    "subcontractorSignals": [
      "협력사",
      "협력업체",
      "하청",
      "사내하청",
      "사내협력사",
      "용역",
      "파견",
      "수급업체",
      "subcontractor"
    ],
    "affiliateSignals": [
      "계열사\\s*노조",
      "자회사\\s*노조",
      "관계사\\s*노조"
    ],
    "mixedRule": "직접고용 노조 신호와 제외 신호가 함께 있으면 자동 분리하지 않고 MIXED_NEEDS_SPLIT",
    "unknownRule": "법인명 또는 검색어 문맥만 있고 직접고용 노조 관계가 확인되지 않으면 UNKNOWN_REVIEW",
    "statusCandidateRule": "PRIMARY_DIRECT_UNION만 주 상태·쟁점·미디어 노출 집계 후보 생성"
  },
  "scopeReviewAgent": {
    "id": "primary-union-scope-review",
    "ruleVersion": "1.1.0",
    "executionOrder": "before_stage_classification",
    "skill": "primary-union-scope-review",
    "publicScope": "selected_legal_entity_direct_employee_union_only",
    "quarantineClassifications": [
      "SUBCONTRACTOR_UNION_EXCLUDED",
      "AFFILIATE_UNION_EXCLUDED",
      "MIXED_NEEDS_SPLIT",
      "UNKNOWN_REVIEW"
    ],
    "onAmbiguous": "human_review_without_public_state_change",
    "legalUpdateProtocol": "Update ruleVersion, legal basis, decision signals, and regression cases together; do not relax public direct-employment scope without product-owner approval."
  },
  "sources": {
    "naver": {
      "endpoint": "https://naverapihub.apigw.ntruss.com/search/v1/news",
      "authentication": "api-hub",
      "sort": "date",
      "clientIdEnvironmentVariables": [
        "NAVER_API_HUB_CLIENT_ID",
        "NAVER_CLIENT_ID",
        "NAVER_API_CLIENT_ID"
      ],
      "clientSecretEnvironmentVariables": [
        "NAVER_API_HUB_CLIENT_SECRET",
        "NAVER_CLIENT_SECRET",
        "NAVER_API_CLIENT_SECRET"
      ]
    },
    "googleNews": {
      "endpoint": "https://news.google.com/rss/search",
      "language": "ko",
      "country": "KR",
      "edition": "KR:ko"
    }
  },
  "relevanceSignals": [
    "임금\\s*(?:협상|교섭|인상|협약)",
    "임단협",
    "단체\\s*(?:협약|교섭)",
    "노사\\s*(?:협상|교섭|합의)",
    "노조.{0,12}(?:교섭|협상|파업|쟁의|합의|요구안)",
    "노동조합.{0,12}(?:교섭|협상|파업|쟁의|합의|요구안)",
    "교섭\\s*(?:결렬|재개|중단)",
    "잠정\\s*합의",
    "쟁의행위",
    "쟁의권",
    "파업",
    "노동위원회.{0,10}조정",
    "교섭창구\\s*단일화|교섭대표노조|교섭단위.{0,8}(?:분리|통합|결정)",
    "(?:합의사항|협약|임금\\s*인상분).{0,10}(?:이행|시행|적용|반영)",
    "(?:소급분|인상분).{0,8}(?:지급|반영)",
    "(?:일부|부분).{0,6}합의",
    "(?:협약|단체협약).{0,10}(?:만료|자동\\s*연장|효력\\s*지속)"
  ],
  "taxonomy": {
    "stages": [
      {
        "code": "preparation",
        "label": "준비",
        "order": 10,
        "signals": [
          "(?:노사|노조).{0,12}(?:요구안|요구사항).{0,8}(?:확정|마련|제시|전달)",
          "임단협.{0,8}(?:요구안|출정식|준비)",
          "교섭.{0,8}(?:상견례|앞두고)",
          "(?:임금|단체)\\s*교섭.{0,8}준비"
        ]
      },
      {
        "code": "bargaining",
        "label": "교섭",
        "order": 20,
        "signals": [
          "(?:임금|단체|임단)\\s*(?:협상|교섭)",
          "(?:노사|노조|사측).{0,10}(?:교섭|협상)",
          "본교섭|실무교섭|보충교섭|재교섭|재협상|교섭\\s*재개|협상\\s*재개",
          "단체협약\\s*(?:교섭|갱신)",
          "교섭.{0,8}(?:진행|개시|시작)"
        ]
      },
      {
        "code": "breakdown_mediation",
        "label": "결렬·조정",
        "order": 30,
        "signals": [
          "(?:교섭|협상).{0,6}(?:결렬|중단)",
          "(?:결렬|중단).{0,6}(?:교섭|협상)",
          "(?:지노위|중노위|노동위원회).{0,12}(?:조정|중재)",
          "(?:조정|중재)\\s*(?:신청|회의|절차|중지|종료)",
          "노동쟁의\\s*조정"
        ]
      },
      {
        "code": "industrial_action",
        "label": "쟁의",
        "order": 40,
        "signals": [
          "쟁의행위\\s*찬반투표.{0,8}(?:가결|찬성)",
          "쟁의권\\s*(?:확보|획득)",
          "(?:부분|전면|총|경고)?\\s*파업\\s*(?:돌입|진행|강행|재개|개시)",
          "파업\\s*중",
          "준법투쟁|태업|잔업\\s*거부|특근\\s*거부",
          "쟁의행위\\s*(?:돌입|개시|재개)",
          "(?:노조|노동조합).{0,12}파업"
        ]
      },
      {
        "code": "tentative_agreement",
        "label": "잠정합의",
        "order": 50,
        "signals": [
          "잠정\\s*합의(?:안)?",
          "(?:일부|부분).{0,6}합의",
          "(?:임금|단체|임단)\\s*(?:협상|교섭).{0,10}합의안\\s*도출",
          "노사.{0,10}잠정안"
        ]
      },
      {
        "code": "final_agreement",
        "label": "최종타결",
        "order": 60,
        "signals": [
          "(?:임금|단체|임단)\\s*(?:협상|교섭).{0,12}(?:최종\\s*)?타결",
          "임단협.{0,12}(?:조인|체결)",
          "(?:단체협약|임금협약).{0,8}(?:조인|체결)",
          "노사.{0,10}(?:최종\\s*합의|협상\\s*타결)"
        ]
      },
      {
        "code": "manual_review",
        "label": "수동검토",
        "order": 0,
        "signals": []
      }
    ],
    "exceptionEvents": [
      {
        "eventType": "rejected_then_action_resumed",
        "patterns": [
          "(?=.*잠정\\s*합의안?.{0,14}(?:부결|거부|무산))(?=.*(?:파업|쟁의행위).{0,8}재개)",
          "(?=.*(?:부결|거부|무산).{0,14}잠정\\s*합의안?)(?=.*(?:파업|쟁의행위).{0,8}재개)"
        ],
        "stage": "industrial_action",
        "transitionHint": "rollback_then_advance",
        "needsReview": true
      },
      {
        "eventType": "tentative_rejected",
        "patterns": [
          "잠정\\s*합의안?.{0,14}(?:부결|거부|무산|폐기)",
          "(?:부결|거부|무산|폐기).{0,14}잠정\\s*합의안?",
          "(?:임단협|합의안|협약안).{0,10}(?:조합원\\s*)?(?:투표.{0,5})?부결"
        ],
        "stage": "bargaining",
        "transitionHint": "rollback_to_bargaining",
        "needsReview": true
      },
      {
        "eventType": "renewed_bargaining_broken",
        "patterns": [
          "(?:재교섭|재협상|교섭\\s*재개|협상\\s*재개).{0,10}(?:결렬|중단)",
          "(?:결렬|중단).{0,10}(?:재교섭|재협상)"
        ],
        "stage": "breakdown_mediation",
        "transitionHint": "rollback_then_breakdown",
        "needsReview": false
      },
      {
        "eventType": "bargaining_resumed",
        "patterns": [
          "재교섭|재협상|교섭\\s*재개|협상\\s*재개"
        ],
        "stage": "bargaining",
        "transitionHint": "resume_or_rollback",
        "needsReview": false,
        "respectGuards": true
      },
      {
        "eventType": "agreement_failed",
        "patterns": [
          "(?:타결|합의).{0,8}(?:실패|불발|무산|파기)",
          "(?:실패|불발|무산|파기).{0,8}(?:타결|합의)"
        ],
        "stage": "breakdown_mediation",
        "transitionHint": "stay_or_rollback",
        "needsReview": true
      },
      {
        "eventType": "industrial_action_withdrawn",
        "patterns": [
          "(?:파업|쟁의행위).{0,8}(?:철회|중단|유보|종료|취소)"
        ],
        "stage": "manual_review",
        "transitionHint": "retain_main_state",
        "needsReview": true
      }
    ],
    "guards": {
      "future": [
        {
          "stageCodes": [
            "bargaining"
          ],
          "fallbackStage": "preparation",
          "patterns": [
            "(?:교섭|협상).{0,8}(?:예정|계획|방침|앞두고|열기로)",
            "(?:예정|계획|방침).{0,8}(?:교섭|협상)"
          ]
        },
        {
          "stageCodes": [
            "breakdown_mediation"
          ],
          "fallbackStage": "bargaining",
          "patterns": [
            "(?:조정\\s*신청|교섭\\s*결렬).{0,8}(?:예정|예고|계획|방침|검토)",
            "(?:예정|예고|계획|방침|검토).{0,8}(?:조정\\s*신청|교섭\\s*결렬)"
          ]
        },
        {
          "stageCodes": [
            "industrial_action"
          ],
          "fallbackStage": "manual_review",
          "patterns": [
            "(?:파업|쟁의행위|준법투쟁).{0,10}(?:예정|예고|계획|방침|검토|찬반투표를?\\s*앞두고)",
            "(?:예정|예고|계획|방침|검토).{0,10}(?:파업|쟁의행위|준법투쟁)",
            "쟁의행위\\s*찬반투표.{0,8}(?:예정|열기로|앞두고)"
          ]
        },
        {
          "stageCodes": [
            "tentative_agreement"
          ],
          "fallbackStage": "bargaining",
          "patterns": [
            "잠정\\s*합의(?:할|를?\\s*추진|를?\\s*목표).{0,6}(?:예정|계획|방침)?"
          ]
        },
        {
          "stageCodes": [
            "final_agreement"
          ],
          "fallbackStage": "tentative_agreement",
          "patterns": [
            "(?:타결|최종\\s*합의).{0,8}(?:예정|전망|기대|목표|계획)",
            "(?:예정|전망|기대|목표|계획).{0,8}(?:타결|최종\\s*합의)"
          ]
        }
      ],
      "negation": [
        {
          "stageCodes": [
            "bargaining"
          ],
          "fallbackStage": "manual_review",
          "patterns": [
            "(?:교섭|협상).{0,7}(?:안\\s*해|않|거부|부인)"
          ]
        },
        {
          "stageCodes": [
            "breakdown_mediation"
          ],
          "fallbackStage": "bargaining",
          "patterns": [
            "(?:결렬|조정\\s*신청).{0,7}(?:아니|않|부인)"
          ]
        },
        {
          "stageCodes": [
            "industrial_action"
          ],
          "fallbackStage": "manual_review",
          "patterns": [
            "(?:파업|쟁의행위).{0,9}(?:안\\s*해|않|없|철회|유보|중단|취소|부인)",
            "(?:철회|유보|중단|취소).{0,8}(?:파업|쟁의행위)"
          ]
        },
        {
          "stageCodes": [
            "tentative_agreement"
          ],
          "fallbackStage": "bargaining",
          "patterns": [
            "잠정\\s*합의안?.{0,9}(?:아니|부인|무산|부결|거부|폐기)"
          ]
        },
        {
          "stageCodes": [
            "final_agreement"
          ],
          "fallbackStage": "breakdown_mediation",
          "patterns": [
            "(?:타결|최종\\s*합의).{0,9}(?:아니|못|실패|불발|무산|부인)"
          ]
        }
      ]
    },
    "transitionPolicy": {
      "normalProgression": [
        "preparation",
        "bargaining",
        "breakdown_mediation",
        "industrial_action",
        "tentative_agreement",
        "final_agreement"
      ],
      "stateKey": [
        "companyId",
        "bargainingUnitId"
      ],
      "neverInferMonotonicProgressFromDateAlone": true,
      "manualReviewOnUnknownUnitWhenMultipleUnits": true
    },
    "statusFramework": {
      "states": [
        {
          "code": "U",
          "name": "unverified",
          "label": "올해 현황 미확인"
        },
        {
          "code": "S0",
          "name": "not_started",
          "label": "미착수·기존협약 확인"
        },
        {
          "code": "S1",
          "name": "preparing",
          "label": "요구안 준비·확정"
        },
        {
          "code": "S2",
          "name": "representation",
          "label": "대표·교섭단위 정비"
        },
        {
          "code": "S3",
          "name": "bargaining",
          "label": "본교섭 진행"
        },
        {
          "code": "S4",
          "name": "impasse_mediation",
          "label": "교착·조정 경로"
        },
        {
          "code": "S5",
          "name": "tentative",
          "label": "잠정합의"
        },
