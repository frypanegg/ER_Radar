  "display_definitions": {
    "channel_majority_union_badge": {
      "label": "교섭창구 과반 노조",
      "legal_meaning": "동일 사업·사업장과 교섭단위의 교섭창구 단일화 절차에 참여한 모든 노조 조합원 중 과반을 조직한 노조인지 여부",
      "allowed_values": [
        "YES",
        "NO",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "must_not_be_inferred_from": [
        "union_member_count alone",
        "representative_union_status",
        "direct_employee_union_membership_rate"
      ],
      "display_rule": "Show O or X only with a numerator, denominator, verified_at, and basis URL; otherwise show 확인중."
    },
    "primary_union_scope": {
      "label": "원청 직접고용 노조 기준",
      "rule": "Only cases where the selected legal entity is the direct employer and covered workers are direct employees may be displayed."
    }
  },
