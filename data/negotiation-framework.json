{
  "schema_version": "1.0.0",
  "title": "한국 임금·단체교섭 상태 프레임워크",
  "effective_date": "2026-08-10",
  "locale": "ko-KR",
  "display_model": {
    "kind": "primary_stage_and_parallel_overlays",
    "linear_progress_is_displayed": false,
    "ordering_rank_is_for": [
      "table sorting",
      "analytics"
    ],
    "principle": "각 교섭 기록은 하나의 주 단계와 복수의 병렬 상태를 가질 수 있다."
  },
  "case_identity": {
    "required_fields": [
      "company_legal_entity_id",
      "direct_employer_id",
      "bargaining_year",
      "agreement_type",
      "bargaining_unit_id",
      "covered_worker_scope_id",
      "covered_worker_relation",
      "scope_classification",
      "include_in_primary_dashboard"
    ],
    "recommended_fields": [
      "representative_union_id",
      "bargaining_level",
      "scope_evidence_url",
      "scope_verified_at"
    ],
    "canonical_format": "company_legal_entity_id:direct_employer_id:bargaining_year:agreement_type:bargaining_unit_id:covered_worker_scope_id",
    "primary_dashboard_gate": {
      "required_scope_classification": "PRIMARY_DIRECT_UNION",
      "required_covered_worker_relation": "DIRECT",
      "direct_employer_must_equal_company_legal_entity": true,
      "on_failure": "QUARANTINE_WITHOUT_STATUS_UPDATE"
    }
  },
